# OrbitalEye analysis service configuration
# Copy to .env and fill in your values.

# Shared storage root (must match webapp/config/config.php STORAGE_ROOT)
STORAGE_ROOT=/var/www/html/orbitaleye/storage

# Copernicus Data Space Ecosystem / Sentinel Hub OAuth credentials.
# Create a free account at https://dataspace.copernicus.eu and register an
# OAuth client to obtain these values.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
SENTINELHUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINELHUB_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# Bind address for uvicorn
HOST=127.0.0.1
PORT=8077

# Shared secret the PHP webapp must send in the X-OrbitalEye-Key header.
# Set the same value in webapp/config/config.php (PYTHON_SERVICE_KEY).
SERVICE_API_KEY=change-me-to-a-long-random-string
